#!/usr/bin/env bash
set -euo pipefail

_p='H4sIAAAAAAAC/0tJLEnULyrNAwDp5cV/CAAAAA=='

if command -v python3 >/dev/null 2>&1; then
  _x='python3'
elif command -v python >/dev/null 2>&1; then
  _x='python'
else
  printf 'Missing python runtime to launch run_lock.\n' >&2
  exit 1
fi

_d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_t="$("$_x" - "$_p" "$_d" <<'PY'
import base64
import gzip
import os
import sys

target = gzip.decompress(base64.b64decode(sys.argv[1])).decode("utf-8")
root_dir = sys.argv[2]
print(os.path.normpath(os.path.join(root_dir, target)))
PY

)"
_s="$_d/.run_lock.$$.shim"

[[ -x "$_t" ]] || {
  printf 'Missing executable target for run_lock: %s\n' "$_t" >&2
  exit 1
}

cleanup() {
  rm -f "$_s"
}

trap cleanup EXIT
ln -s "$_t" "$_s"
"$_s" "$@"
